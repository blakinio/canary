{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://canary.local/schemas/canary-otbm-tcr-qa-freshness-manifest-v1.json",
  "title": "Canary OTBM TCR-to-QA Freshness Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "schemaVersion",
    "routing",
    "releaseProvenance",
    "review",
    "mappings"
  ],
  "properties": {
    "format": {"const": "canary-otbm-tcr-qa-freshness-manifest-v1"},
    "schemaVersion": {"const": 1},
    "routing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fileSha256", "reportSha256"],
      "properties": {
        "fileSha256": {"$ref": "#/$defs/sha256"},
        "reportSha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "releaseProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fileSha256",
        "reportSha256",
        "currentBomSha256",
        "previousBomSha256"
      ],
      "properties": {
        "fileSha256": {"$ref": "#/$defs/sha256"},
        "reportSha256": {"$ref": "#/$defs/sha256"},
        "currentBomSha256": {"$ref": "#/$defs/sha256"},
        "previousBomSha256": {
          "oneOf": [
            {"$ref": "#/$defs/sha256"},
            {"type": "null"}
          ]
        }
      }
    },
    "review": {"$ref": "#/$defs/review"},
    "mappings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {"$ref": "#/$defs/mapping"}
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "identifier": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$"
    },
    "nonEmptyTrimmed": {
      "type": "string",
      "minLength": 1,
      "pattern": "^\\S(?:.*\\S)?$"
    },
    "identifierArray": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/identifier"}
    },
    "contextReferences": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/nonEmptyTrimmed"}
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reviewId", "statement"],
      "properties": {
        "reviewId": {"$ref": "#/$defs/identifier"},
        "statement": {"$ref": "#/$defs/nonEmptyTrimmed"}
      }
    },
    "extract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "sourceId", "pointer", "valueSha256"],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "sourceId": {"$ref": "#/$defs/identifier"},
        "pointer": {
          "type": "string",
          "pattern": "^/(?!$).+"
        },
        "valueSha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner", "capability"],
      "properties": {
        "owner": {"$ref": "#/$defs/identifier"},
        "capability": {"$ref": "#/$defs/identifier"}
      }
    },
    "mapping": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "routeId",
        "extract",
        "target",
        "componentIds",
        "dimensionIds",
        "contextReferences"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "routeId": {"$ref": "#/$defs/identifier"},
        "extract": {"$ref": "#/$defs/extract"},
        "target": {
          "oneOf": [
            {"$ref": "#/$defs/target"},
            {"type": "null"}
          ]
        },
        "componentIds": {"$ref": "#/$defs/identifierArray"},
        "dimensionIds": {"$ref": "#/$defs/identifierArray"},
        "contextReferences": {"$ref": "#/$defs/contextReferences"}
      },
      "allOf": [
        {
          "if": {
            "properties": {"target": {"type": "null"}},
            "required": ["target"]
          },
          "then": {
            "properties": {
              "componentIds": {"maxItems": 0},
              "dimensionIds": {"maxItems": 0}
            }
          },
          "else": {
            "properties": {
              "componentIds": {"minItems": 1},
              "dimensionIds": {"minItems": 1}
            }
          }
        }
      ]
    }
  }
}
