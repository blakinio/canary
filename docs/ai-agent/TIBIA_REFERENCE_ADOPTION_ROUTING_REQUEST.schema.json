{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://canary.local/schemas/canary-tibia-reference-adoption-routing-request-v1.json",
  "title": "Canary Tibia Reference Adoption Routing Request v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "schemaVersion", "gateway", "review", "routes"],
  "properties": {
    "format": {"const": "canary-tibia-reference-adoption-routing-request-v1"},
    "schemaVersion": {"const": 1},
    "gateway": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fileSha256", "reportSha256", "evidenceBundleSha256", "bindingId", "kind"],
      "properties": {
        "fileSha256": {"$ref": "#/$defs/sha256"},
        "reportSha256": {"$ref": "#/$defs/sha256"},
        "evidenceBundleSha256": {"$ref": "#/$defs/sha256"},
        "bindingId": {"$ref": "#/$defs/identifier"},
        "kind": {"$ref": "#/$defs/kind"}
      }
    },
    "review": {"$ref": "#/$defs/review"},
    "routes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {"$ref": "#/$defs/route"}
    }
  },
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "kind": {"enum": ["house", "content", "proficiency", "drift"]},
    "contextReferences": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reviewId", "statement"],
      "properties": {
        "reviewId": {"$ref": "#/$defs/identifier"},
        "statement": {"type": "string", "minLength": 1}
      }
    },
    "extract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "sourceId", "pointer", "valueSha256"],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "sourceId": {"$ref": "#/$defs/identifier"},
        "pointer": {"type": "string", "pattern": "^/.+"},
        "valueSha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "target": {
      "oneOf": [
        {"$ref": "#/$defs/targetOtbmRepair"},
        {"$ref": "#/$defs/targetAchievement"},
        {"$ref": "#/$defs/targetCyclopedia"},
        {"$ref": "#/$defs/targetSpawnNpc"},
        {"$ref": "#/$defs/targetQuestMap"},
        {"$ref": "#/$defs/targetStorageGraph"},
        {"$ref": "#/$defs/targetWeaponProficiency"},
        {"$ref": "#/$defs/targetTcrManifest"},
        {"$ref": "#/$defs/targetTcrHouse"},
        {"$ref": "#/$defs/targetTcrContent"},
        {"$ref": "#/$defs/targetTcrProficiency"}
      ]
    },
    "targetBase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner", "capability"]
    },
    "targetOtbmRepair": {
      "allOf": [
        {"$ref": "#/$defs/targetBase"},
        {"properties": {"owner": {"const": "otbm-repair-recommendation"}, "capability": {"const": "canary-otbm-repair-recommendation-v1"}}}
      ]
    },
    "targetAchievement": {
      "allOf": [
        {"$ref": "#/$defs/targetBase"},
        {"properties": {"owner": {"const": "achievement-validation"}, "capability": {"const": "canary-achievement-audit-v2"}}}
      ]
    },
    "targetCyclopedia": {
      "allOf": [
        {"$ref": "#/$defs/targetBase"},
        {"properties": {"owner": {"const": "cyclopedia-validation"}, "capability": {"const": "module-catalog:cyclopedia-validation"}}}
      ]
    },
    "targetSpawnNpc": {
      "allOf": [
        {"$ref": "#/$defs/targetBase"},
        {"properties": {"owner": {"const": "otbm-spawn-npc-validation"}, "capability": {"const": "canary-otbm-spawn-npc-validation-v1"}}}
      ]
    },
    "targetQuestMap": {
      "allOf": [
        {"$ref": "#/$defs/targetBase"},
        {"properties": {"owner": {"const": "quest-map-validation"}, "capability": {"const": "canary-quest-map-evidence-v1"}}}
      ]
    },
    "targetStorageGraph": {
      "allOf": [
        {"$ref": "#/$defs/targetBase"},
        {"properties": {"owner": {"const": "otbm-storage-graph"}, "capability": {"const": "canary-otbm-storage-graph-v1"}}}
      ]
    },
    "targetWeaponProficiency": {
      "allOf": [
        {"$ref": "#/$defs/targetBase"},
        {"properties": {"owner": {"const": "weapon-proficiency"}, "capability": {"const": "module-catalog:weapon-proficiency"}}}
      ]
    },
    "targetTcrManifest": {
      "allOf": [
        {"$ref": "#/$defs/targetBase"},
        {"properties": {"owner": {"const": "tcr-client-manifest"}, "capability": {"const": "canary-tibia-client-reference-manifest-v1"}}}
      ]
    },
    "targetTcrHouse": {
      "allOf": [
        {"$ref": "#/$defs/targetBase"},
        {"properties": {"owner": {"const": "tcr-house-parity"}, "capability": {"const": "canary-otbm-house-reference-parity-v1"}}}
      ]
    },
    "targetTcrContent": {
      "allOf": [
        {"$ref": "#/$defs/targetBase"},
        {"properties": {"owner": {"const": "tcr-content-correlation"}, "capability": {"const": "canary-tibia-content-reference-correlation-v1"}}}
      ]
    },
    "targetTcrProficiency": {
      "allOf": [
        {"$ref": "#/$defs/targetBase"},
        {"properties": {"owner": {"const": "tcr-proficiency-correlation"}, "capability": {"const": "canary-tibia-proficiency-reference-correlation-v1"}}}
      ]
    },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "extract", "disposition", "targets", "reasonCode", "contextReferences"],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "extract": {"$ref": "#/$defs/extract"},
        "disposition": {"enum": ["routed", "unsupported", "blocked"]},
        "targets": {
          "type": "array",
          "maxItems": 4,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/target"}
        },
        "reasonCode": {
          "enum": [
            "reviewed-existing-owner-capability",
            "unsupported-map-change-shape",
            "unsupported-existing-capability",
            "unsupported-fragment-shape",
            "conflicting-evidence",
            "stale-evidence",
            "unresolved-id-space",
            "missing-downstream-evidence"
          ]
        },
        "contextReferences": {"$ref": "#/$defs/contextReferences"}
      },
      "allOf": [
        {
          "if": {"properties": {"disposition": {"const": "routed"}}, "required": ["disposition"]},
          "then": {
            "properties": {
              "targets": {"minItems": 1},
              "reasonCode": {"const": "reviewed-existing-owner-capability"}
            }
          }
        },
        {
          "if": {"properties": {"disposition": {"const": "unsupported"}}, "required": ["disposition"]},
          "then": {
            "properties": {
              "targets": {"maxItems": 0},
              "reasonCode": {"enum": ["unsupported-map-change-shape", "unsupported-existing-capability", "unsupported-fragment-shape"]}
            }
          }
        },
        {
          "if": {"properties": {"disposition": {"const": "blocked"}}, "required": ["disposition"]},
          "then": {
            "properties": {
              "targets": {"maxItems": 0},
              "reasonCode": {"enum": ["conflicting-evidence", "stale-evidence", "unresolved-id-space", "missing-downstream-evidence"]}
            }
          }
        }
      ]
    }
  }
}
