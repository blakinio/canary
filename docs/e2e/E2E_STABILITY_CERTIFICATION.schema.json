{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/blakinio/canary/blob/main/docs/e2e/E2E_STABILITY_CERTIFICATION.schema.json",
  "title": "Canary Universal E2E stability certification",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "schema_version",
    "generated_at",
    "policy",
    "evidence_boundary",
    "summary",
    "certifications",
    "duplicate_attempt_identities",
    "invalid_evidence"
  ],
  "properties": {
    "contract": {
      "const": "canary-universal-e2e-stability-certification-v1"
    },
    "schema_version": {
      "const": 1
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "policy": {
      "$ref": "#/$defs/policy"
    },
    "evidence_boundary": {
      "$ref": "#/$defs/evidenceBoundary"
    },
    "summary": {
      "$ref": "#/$defs/summary"
    },
    "certifications": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/certification"
      }
    },
    "duplicate_attempt_identities": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/duplicateAttempt"
      }
    },
    "invalid_evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/invalidEvidence"
      }
    }
  },
  "$defs": {
    "nonNegativeInteger": {
      "type": "integer",
      "minimum": 0
    },
    "positiveInteger": {
      "type": "integer",
      "minimum": 1
    },
    "nullableString": {
      "type": [
        "string",
        "null"
      ]
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minimum_runs",
        "comparability_fields",
        "pass_definition",
        "mixed_result_state",
        "insufficient_result_state",
        "incomplete_evidence_state",
        "retry_policy"
      ],
      "properties": {
        "minimum_runs": {
          "$ref": "#/$defs/positiveInteger"
        },
        "comparability_fields": {
          "const": [
            "server_revision",
            "client_revision",
            "datapack",
            "execution_tier"
          ]
        },
        "pass_definition": {
          "const": "every counted attempt has status success and exact cleanup certification pass"
        },
        "mixed_result_state": {
          "const": "unstable"
        },
        "insufficient_result_state": {
          "const": "not-evaluated"
        },
        "incomplete_evidence_state": {
          "const": "blocked"
        },
        "retry_policy": {
          "const": "all-attempts-retained-no-hidden-retry"
        }
      }
    },
    "root": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "result_files"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^evidence-[1-9][0-9]*$"
        },
        "result_files": {
          "$ref": "#/$defs/nonNegativeInteger"
        }
      }
    },
    "evidenceBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "roots",
        "valid_envelope_count",
        "invalid_result_count",
        "collection_execution_and_retention"
      ],
      "properties": {
        "source": {
          "const": "explicit-local-extracted-artifact-roots"
        },
        "roots": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/root"
          }
        },
        "valid_envelope_count": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "invalid_result_count": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "collection_execution_and_retention": {
          "const": "external-to-this-contract"
        }
      }
    },
    "countMap": {
      "type": "object",
      "propertyNames": {
        "enum": [
          "not-evaluated",
          "pass",
          "fail",
          "unstable",
          "blocked"
        ]
      },
      "additionalProperties": {
        "$ref": "#/$defs/nonNegativeInteger"
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scenario_count",
        "certification_cell_count",
        "attempt_count",
        "clean_pass_count",
        "failed_attempt_count",
        "blocked_attempt_count",
        "cleanup_failure_count",
        "duplicate_attempt_identity_count",
        "state_counts"
      ],
      "properties": {
        "scenario_count": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "certification_cell_count": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "attempt_count": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "clean_pass_count": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "failed_attempt_count": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "blocked_attempt_count": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "cleanup_failure_count": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "duplicate_attempt_identity_count": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "state_counts": {
          "$ref": "#/$defs/countMap"
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "server_revision",
        "client_revision",
        "datapack",
        "execution_tier"
      ],
      "properties": {
        "server_revision": {
          "$ref": "#/$defs/nullableString"
        },
        "client_revision": {
          "$ref": "#/$defs/nullableString"
        },
        "datapack": {
          "$ref": "#/$defs/nullableString"
        },
        "execution_tier": {
          "anyOf": [
            {
              "enum": [
                "pr-required",
                "scheduled",
                "release-certification",
                "on-demand",
                "unknown"
              ]
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "cleanup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "cleanup_certified",
        "contract_valid"
      ],
      "properties": {
        "status": {
          "type": "string"
        },
        "cleanup_certified": {
          "type": "boolean"
        },
        "contract_valid": {
          "type": "boolean"
        }
      }
    },
    "attemptSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "root_id",
        "path",
        "attempt_history_index"
      ],
      "properties": {
        "root_id": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "attempt_history_index": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "attempt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity",
        "run_id",
        "attempt",
        "status",
        "outcome",
        "clean_pass",
        "started_at",
        "ended_at",
        "duration_ms",
        "failure_classification",
        "failure_category",
        "first_divergence",
        "cleanup",
        "source"
      ],
      "properties": {
        "identity": {
          "type": "string",
          "minLength": 1
        },
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "attempt": {
          "$ref": "#/$defs/positiveInteger"
        },
        "status": {
          "enum": [
            "success",
            "failure",
            "cancelled",
            "timeout"
          ]
        },
        "outcome": {
          "enum": [
            "clean-pass",
            "failed",
            "blocked"
          ]
        },
        "clean_pass": {
          "type": "boolean"
        },
        "started_at": {
          "type": "string",
          "format": "date-time"
        },
        "ended_at": {
          "type": "string",
          "format": "date-time"
        },
        "duration_ms": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "failure_classification": {
          "$ref": "#/$defs/nullableString"
        },
        "failure_category": {
          "$ref": "#/$defs/nullableString"
        },
        "first_divergence": {
          "$ref": "#/$defs/nullableString"
        },
        "cleanup": {
          "$ref": "#/$defs/cleanup"
        },
        "source": {
          "$ref": "#/$defs/attemptSource"
        }
      }
    },
    "duration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "count",
        "min_ms",
        "p50_ms",
        "p95_ms",
        "max_ms"
      ],
      "properties": {
        "count": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "min_ms": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "p50_ms": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "p95_ms": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "max_ms": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "stringCountMap": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1
      },
      "additionalProperties": {
        "$ref": "#/$defs/positiveInteger"
      }
    },
    "certification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scenario",
        "cell_id",
        "provenance",
        "state",
        "reason",
        "minimum_runs",
        "run_count",
        "clean_pass_count",
        "failed_attempt_count",
        "blocked_attempt_count",
        "success_ratio",
        "cleanup_failure_count",
        "cleanup_unknown_count",
        "failure_class_distribution",
        "first_divergence_distribution",
        "duration_ms",
        "duplicate_attempt_identities",
        "missing_provenance",
        "warnings",
        "unknowns",
        "attempts"
      ],
      "properties": {
        "scenario": {
          "type": "string",
          "pattern": "^[^/]+/[^/]+$"
        },
        "cell_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{20}$"
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        },
        "state": {
          "enum": [
            "not-evaluated",
            "pass",
            "fail",
            "unstable",
            "blocked"
          ]
        },
        "reason": {
          "enum": [
            "complete-clean-pass-set",
            "mixed-outcomes",
            "all-attempts-failed",
            "insufficient-runs",
            "incomplete-provenance",
            "duplicate-attempt-identity",
            "incomplete-attempt-evidence"
          ]
        },
        "minimum_runs": {
          "$ref": "#/$defs/positiveInteger"
        },
        "run_count": {
          "$ref": "#/$defs/positiveInteger"
        },
        "clean_pass_count": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "failed_attempt_count": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "blocked_attempt_count": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "success_ratio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "cleanup_failure_count": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "cleanup_unknown_count": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "failure_class_distribution": {
          "$ref": "#/$defs/stringCountMap"
        },
        "first_divergence_distribution": {
          "$ref": "#/$defs/stringCountMap"
        },
        "duration_ms": {
          "$ref": "#/$defs/duration"
        },
        "duplicate_attempt_identities": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "missing_provenance": {
          "type": "array",
          "items": {
            "enum": [
              "server_revision",
              "client_revision",
              "datapack",
              "execution_tier"
            ]
          },
          "uniqueItems": true
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "unknowns": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "attempts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/attempt"
          }
        }
      }
    },
    "invalidSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "root_id",
        "path"
      ],
      "properties": {
        "root_id": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "invalidEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "error"
      ],
      "properties": {
        "source": {
          "$ref": "#/$defs/invalidSource"
        },
        "error": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "duplicateAttempt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scenario",
        "identity",
        "occurrences"
      ],
      "properties": {
        "scenario": {
          "type": "string",
          "pattern": "^[^/]+/[^/]+$"
        },
        "identity": {
          "type": "string",
          "minLength": 1
        },
        "occurrences": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/attemptSource"
          }
        }
      }
    }
  }
}
